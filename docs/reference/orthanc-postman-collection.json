        },
        {
          "name": "POST /studies/:id/anonymize — Anonimisasi Studi",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/studies/{{study_id}}/anonymize",
              "host": ["{{base_url}}"],
              "path": ["studies", "{{study_id}}", "anonymize"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Replace\": {\n    \"PatientName\": \"ANONYMIZED\"\n  }\n}"
