{
  "info": {
    "name": "Orthanc DICOM Server API",
    "description": "Koleksi lengkap REST API Orthanc DICOM Server.\n\n**Base URL:** `http://localhost:8042`\n**Auth:** Basic Auth (default: orthanc:orthanc)\n\nDokumentasi lengkap: [ORTHANC-API-REFERENCE.md](./ORTHANC-API-REFERENCE.md)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "orthanc-api-design"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "orthanc", "type": "string" },
      { "key": "password", "value": "orthanc", "type": "string" }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8042",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "study_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "series_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "instance_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System",
      "description": "Endpoint untuk informasi sistem dan konfigurasi server Orthanc.",
      "item": [
        {
          "name": "GET /system — Info Server",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/system",
              "host": ["{{base_url}}"],
              "path": ["system"]
            },
            "description": "Mengembalikan informasi detail server Orthanc: versi, konfigurasi, kapabilitas."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"ApiVersion\": 29,\n  \"DatabaseVersion\": 6,\n  \"DicomAet\": \"ORTHANC\",\n  \"DicomPort\": 4242,\n  \"HttpPort\": 8042,\n  \"Name\": \"Orthanc inside Docker\",\n  \"Version\": \"mainline\",\n  \"ReadOnly\": false,\n  \"PluginsEnabled\": true,\n  \"StorageCompression\": false\n}"
            }
          ]
        },
        {
          "name": "GET /tools/now — Waktu Server (UTC)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tools/now",
              "host": ["{{base_url}}"],
              "path": ["tools", "now"]
            },
            "description": "Mengembalikan waktu server dalam format UTC: YYYYMMDDThhmmss"
          }
        },
        {
          "name": "GET /tools/now-local — Waktu Server (Lokal)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tools/now-local",
              "host": ["{{base_url}}"],
              "path": ["tools", "now-local"]
            },
            "description": "Mengembalikan waktu server dalam zona waktu lokal."
          }
        },
        {
          "name": "GET /tools/generate-uid — Generate UID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tools/generate-uid",
              "host": ["{{base_url}}"],
              "path": ["tools", "generate-uid"]
            },
            "description": "Menghasilkan DICOM UID unik untuk objek DICOM baru."
          }
        },
        {
          "name": "GET /tools/default-encoding — Default Encoding",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tools/default-encoding",
              "host": ["{{base_url}}"],
              "path": ["tools", "default-encoding"]
            },
            "description": "Menampilkan encoding default server (Latin1, UTF-8, dll)."
          }
        },
        {
          "name": "GET /tools/dicom-conformance — DICOM Statement",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tools/dicom-conformance",
              "host": ["{{base_url}}"],
              "path": ["tools", "dicom-conformance"]
            },
            "description": "Menampilkan SOP Classes yang didukung Orthanc untuk C-Store SCP."
          }
        }
      ]
    },
    {
      "name": "2. Patients",
      "description": "CRUD operations untuk resource Patient.",
      "item": [
        {
          "name": "GET /patients — Semua Pasien",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/patients",
              "host": ["{{base_url}}"],
              "path": ["patients"],
              "query": [
                {
                  "key": "expand",
                  "value": "false",
                  "description": "Jika true, kembalikan objek lengkap (bukan hanya ID)",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "",
                  "description": "Batasi jumlah hasil",
                  "disabled": true
                },
                {
                  "key": "since",
                  "value": "",
                  "description": "Pagination: mulai dari ID tertentu",
                  "disabled": true
                }
              ]
            },
            "description": "Mengembalikan daftar semua pasien dalam database."
          }
        },
        {
          "name": "GET /patients?expand=true — Semua Pasien (Detail)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/patients?expand=true",
              "host": ["{{base_url}}"],
              "path": ["patients"],
              "query": [
                {
                  "key": "expand",
                  "value": "true"
                }
              ]
            },
            "description": "Mengembalikan semua pasien dengan detail lengkap."
          }
        },
        {
          "name": "GET /patients/:id — Detail Pasien",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/patients/{{patient_id}}",
              "host": ["{{base_url}}"],
              "path": ["patients", "{{patient_id}}"]
            },
            "description": "Mengembalikan detail pasien termasuk MainDicomTags dan daftar studi."
          }
        },
        {
          "name": "GET /patients/:id/studies — Studi Pasien",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/patients/{{patient_id}}/studies",
              "host": ["{{base_url}}"],
              "path": ["patients", "{{patient_id}}", "studies"]
            },
            "description": "Mengembalikan semua studi milik pasien tertentu."
          }
        },
        {
          "name": "POST /patients/:id/anonymize — Anonimisasi",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/patients/{{patient_id}}/anonymize",
              "host": ["{{base_url}}"],
              "path": ["patients", "{{patient_id}}", "anonymize"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Replace\": {\n    \"PatientName\": \"ANONYMIZED\",\n    \"PatientID\": \"ANON001\"\n  }\n}"
            },
            "description": "Membuat salinan pasien dengan data identitas yang diganti."
          }
        },
        {
          "name": "POST /patients/:id/protected — Proteksi Pasien",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/patients/{{patient_id}}/protected",
              "host": ["{{base_url}}"],
              "path": ["patients", "{{patient_id}}", "protected"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "true"
            },
            "description": "Mencegah penghapusan tidak sengaja. Set ke false untuk unproteksi."
          }
        },
        {
          "name": "DELETE /patients/:id — Hapus Pasien",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/patients/{{patient_id}}",
              "host": ["{{base_url}}"],
              "path": ["patients", "{{patient_id}}"]
            },
            "description": "Menghapus pasien beserta semua studi, series, dan instances-nya."
          }
        }
      ]
    },
