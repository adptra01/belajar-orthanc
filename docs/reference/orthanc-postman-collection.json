    {
      "name": "6. Tools & Utilities",
      "description": "Endpoint utility untuk pencarian, monitoring, dan maintenance.",
      "item": [
        {
          "name": "POST /tools/find — Cari Pasien",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/tools/find",
              "host": ["{{base_url}}"],
              "path": ["tools", "find"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Level\": \"Patient\",\n  \"Query\": {\n    \"PatientName\": \"*\"\n  }\n}"
            },
            "description": "Cari semua pasien. Wildcard '*' untuk semua."
          }
        },
        {
          "name": "POST /tools/find — Cari Studi by Date",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/tools/find",
              "host": ["{{base_url}}"],
              "path": ["tools", "find"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Level\": \"Study\",\n  \"Query\": {\n    \"StudyDate\": \"20260427\"\n  }\n}"
            },
            "description": "Cari studi berdasarkan tanggal. Format: YYYYMMDD"
          }
        },
        {
          "name": "POST /tools/find — Cari Series by Modality",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/tools/find",
              "host": ["{{base_url}}"],
